#!/usr/bin/env bash
#
# rps — Windows <-> WSL path converter
#
# A thin wrapper around wslpath that picks the conversion direction for
# you. See --help.

set -euo pipefail

usage() {
    cat <<'EOF'
Usage:
    rps [OPTIONS] [PATH]

Convert a path between Windows and WSL formats. The direction is
detected automatically:

    rps "C:\Users\moussa\file.txt"   ->  /mnt/c/Users/moussa/file.txt
    rps "/mnt/c/Users/moussa"        ->  C:\Users\moussa

Options:
    -u, --wsl       Force WSL format
    -w, --win       Force Windows format
    -b, --both      Print both formats (WSL first, Windows second)
    -d, --directory Print the folder to cd into: a directory stays as-is,
                    a file becomes its parent folder
    -r, --remove    Remove the file (asks for confirmation)
    -c, --copy      Copy the converted path to the clipboard
    -e, --explorer  Open the path in Windows Explorer
    -h, --help      Show this help

With no PATH the current directory is used. With no options at all,
'rps' prints both formats of the current directory.

Flags must come before PATH; use '--' to end flag parsing.
EOF
}

die() {
    printf 'rps: %s\n' "$1" >&2
    exit "${2:-1}"
}

set_action() {
    if [ -n "$action" ] && [ "$action" != "$1" ]; then
        die "conflicting actions: use only one of -d/-r/-c/-e" 2
    fi
    action=$1
}

is_windows_path() {
    case "$1" in
        [A-Za-z]:[\\/]* | [A-Za-z]: | \\\\*) return 0 ;;
    esac
    return 1
}

# Convert according to the -u/-w/auto direction rule
convert() {
    case "$direction" in
        wsl) to_wsl "$1" ;;
        win) to_win "$1" ;;
        *)
            if is_windows_path "$1"; then
                to_wsl "$1"
            else
                to_win "$1"
            fi
            ;;
    esac
}

copy_to_clipboard() {
    if command -v clip.exe >/dev/null 2>&1; then
        printf '%s' "$1" | clip.exe
    elif command -v xclip >/dev/null 2>&1; then
        printf '%s' "$1" | xclip -selection clipboard
    elif command -v xsel >/dev/null 2>&1; then
        printf '%s' "$1" | xsel --clipboard --input
    elif command -v wl-copy >/dev/null 2>&1; then
        printf '%s' "$1" | wl-copy
    else
        die "no clipboard tool found (clip.exe, xclip, xsel or wl-copy)"
    fi
}

open_in_explorer() {
    if command -v explorer.exe >/dev/null 2>&1; then
        explorer.exe "$1" >/dev/null 2>&1 || true
    elif command -v wslview >/dev/null 2>&1; then
        wslview "$1" >/dev/null 2>&1 || true
    else
        die "cannot open Windows Explorer (need explorer.exe or wslview)"
    fi
}

to_wsl() {
    local out
    if ! out=$(wslpath -u "$1" 2>&1); then
        die "cannot convert '$1' to a WSL path: $out"
    fi
    printf '%s\n' "$out"
}

to_win() {
    local out
    if ! out=$(wslpath -w "$1" 2>&1); then
        die "cannot convert '$1' to a Windows path: $out"
    fi
    printf '%s\n' "$out"
}

# ---------------------------------------------------------------- parsing
both=0
direction=auto
action=""
argc=$#

while [ $# -gt 0 ]; do
    case "$1" in
        -h | --help)
            usage
            exit 0
            ;;
        -u | --wsl) direction=wsl ;;
        -w | --win) direction=win ;;
        -b | --both) both=1 ;;
        -d | --directory) set_action dir ;;
        -r | --remove) set_action remove ;;
        -c | --copy) set_action copy ;;
        -e | --explorer) set_action explorer ;;
        --)
            shift
            break
            ;;
        -*)
            usage >&2
            die "unknown option: $1" 2
            ;;
        *)
            break
            ;;
    esac
    shift
done

if [ $argc -eq 0 ]; then
    both=1
fi

if [ $# -le 1 ]; then
    :
else
    die "too many arguments (flags must come before PATH)" 2
fi

path=${1:-}
if [ -n "$path" ]; then
    path="${path/#\~/$HOME}"
else
    path=$(pwd)
fi

command -v wslpath >/dev/null 2>&1 ||
    die "wslpath not found — rps must run inside WSL"

# --------------------------------------------------------------- actions
# Path in WSL form, for filesystem operations (-d, -r)
wsl_target() {
    if is_windows_path "$1"; then
        to_wsl "$1"
    else
        printf '%s\n' "$1"
    fi
}

# Path in Windows form (-e)
win_target() {
    if is_windows_path "$1"; then
        wslpath -w "$1" 2>/dev/null || printf '%s\n' "$1"
    else
        to_win "$1"
    fi
}

if [ -n "$action" ]; then
    case "$action" in
        dir)
            target=$(wsl_target "$path")
            if [ -d "$target" ]; then
                :
            elif [ -e "$target" ]; then
                target=$(dirname -- "$target")
            fi
            printf '%s\n' "$target"
            ;;
        remove)
            target=$(wsl_target "$path")
            if [ ! -e "$target" ]; then
                die "no such file: $target"
            fi
            rm -i -- "$target"
            if [ ! -e "$target" ]; then
                printf 'removed: %s\n' "$target"
            fi
            ;;
        copy)
            result=$(convert "$path")
            copy_to_clipboard "$result"
            printf 'copied: %s\n' "$result"
            ;;
        explorer)
            win=$(win_target "$path")
            open_in_explorer "$win"
            printf 'opened: %s\n' "$win"
            ;;
    esac
    exit 0
fi

# --------------------------------------------------------------- convert
if [ "$both" -eq 1 ]; then
    if is_windows_path "$path"; then
        wsl=$(to_wsl "$path")
        win=$(wslpath -w "$path" 2>/dev/null) || win=$path
    else
        wsl=$path
        win=$(to_win "$path")
    fi
    printf '%s\n%s\n' "$wsl" "$win"
    exit 0
fi

result=$(convert "$path")

printf '%s\n' "$result"
